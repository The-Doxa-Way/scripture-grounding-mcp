{
  "name": "scripture-grounding-mcp",
  "version": "0.1.0",
  "description": "An MCP server that grounds LLM Scripture quotation in canonical text retrieved via the YouVersion Platform API, with values-aligned generation via Gloo AI Studio. Built for the Kaggle \"Scripture in New Frontiers\" challenge.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "bin": {
    "scripture-grounding-mcp": "src/index.js"
  },
  "files": [
    "src",
    "fixtures",
    "data"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test \"tests/**/*.test.js\" \"evals/*.test.js\"",
    "build:fixtures": "node scripts/build-fixtures.js",
    "benchmark": "node benchmark/runner.js --model gloo --condition all",
    "evals": "node evals/run-safety-evals.js"
  },
  "license": "MIT",
  "author": "The Doxa Way Ltd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Doxa-Way/scripture-grounding-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "scripture",
    "bible",
    "youversion",
    "gloo-ai",
    "kaggle"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "puppeteer-core": "^25.4.0"
  }
}
