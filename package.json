{
  "name": "scripture-grounding-mcp",
  "version": "0.1.0",
  "description": "An MCP server that grounds LLM Scripture quotation in canonical text — retrieval and verification only, never generation. Runs keyless on the committed public-domain BSB corpus, with the YouVersion Platform API as an optional upgrade. Built for the Kaggle \"Scripture in New Frontiers\" challenge.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "bin": {
    "scripture-grounding-mcp": "src/index.js"
  },
  "files": [
    "src",
    "fixtures",
    "data"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test \"tests/**/*.test.js\" \"tests/**/*.test.cjs\" \"evals/*.test.js\"",
    "test:books": "node scripts/verify-all-books.js",
    "build:fixtures": "node scripts/build-fixtures.js",
    "benchmark": "node benchmark/runner.js --model stub --condition all"
  },
  "license": "MIT",
  "author": "The Doxa Way Ltd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Doxa-Way/scripture-grounding-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "scripture",
    "bible",
    "youversion",
    "kaggle"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "puppeteer-core": "^25.4.0"
  }
}
