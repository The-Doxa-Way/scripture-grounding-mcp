{
  "version": 2,
  "functions": {
    "api/*.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/openapi.yaml", "destination": "/api/openapi" },
    { "source": "/notebook", "destination": "/notebook.html" },
    { "source": "/notebook/", "destination": "/notebook.html" },
    { "source": "/", "destination": "/public/index.html" }
  ]
}
